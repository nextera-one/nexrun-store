<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>one.nextera.nexrun</groupId>
  <artifactId>nexrun-store</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javelle.version>0.1.69</javelle.version>
    <junit.version>5.11.4</junit.version>
    <json-schema-validator.version>1.5.1</json-schema-validator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>one.nextera.openat.javelle</groupId>
        <artifactId>javelle-bom</artifactId>
        <version>${javelle.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>one.nextera.openat.javelle</groupId>
      <artifactId>javelle-core</artifactId>
    </dependency>

    <dependency>
      <groupId>one.nextera.openat.javelle</groupId>
      <artifactId>javelle-ui</artifactId>
    </dependency>

    <!--
      The catalog is the trust surface of this repository, so it is validated by
      `mvn test` and not only by CI. See CatalogSchemaTest and CatalogDriftTest.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!--
            `mvn test` must never pass vacuously on this repository: the catalog
            tests are the only thing standing between a bad record and the site.
          -->
          <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
          <systemPropertyVariables>
            <nexrunStore.basedir>${project.basedir}</nexrunStore.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
