{
  "appName": "NexRun Store",
  "sourcePackage": "one.nextera.nexrun.store",
  "pageFormat": "jvl",
  "mvcKind": "basic",
  "androidPackageId": "",
  "iosBundleId": "",
  "groupId": "one.nextera.nexrun",
  "javelleVersion": "0.1.59",
  "styles": [
    {
      "href": "/styles/app.css",
      "source": "src/main/resources/styles/app.css",
      "type": "css"
    }
  ],
  "ui": {
    "enabled": true,
    "preset": "material3",
    "darkMode": "auto",
    "rtl": false,
    "theme": {
      "primary": "#6EE7B7",
      "secondary": "#60A5FA",
      "tertiary": "#A78BFA",
      "error": "#FB7185",
      "radius": "md",
      "density": "comfortable"
    },
    "fonts": {
      "provider": "google",
      "mode": "self-host",
      "families": [
        {
          "name": "Inter",
          "weights": [400, 500, 700]
        }
      ],
      "display": "swap"
    },
    "icons": {
      "set": "material-symbols",
      "style": "rounded",
      "mode": "cdn",
      "axes": {
        "fill": 0,
        "weight": 400,
        "grade": 0,
        "opticalSize": 24
      }
    }
  },
  "boot": [
    "one.nextera.nexrun.store.boot.RouterBoot"
  ],
  "modes": {
